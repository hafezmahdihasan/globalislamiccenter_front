# --- Database ---
MONGODB_URI=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram user IDs allowed to use the admin bot
TELEGRAM_ALLOWED_USER_IDS=
# Comma-separated chat IDs that receive new-inquiry notifications
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_ADMIN_EMAIL=
# bcrypt hash of the admin password (generate with: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))")
TELEGRAM_ADMIN_PASSWORD_HASH=
# Optional: session lifetime in hours (default 8)
TELEGRAM_SESSION_HOURS=8

# --- reCAPTCHA v3 ---
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Optional: minimum accepted score (default 0.5)
RECAPTCHA_MIN_SCORE=0.5

# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_GIC_EMAIL=

# --- PDF export ---
# Optional: path to a Chrome/Chromium binary for local development.
# On Vercel/AWS the bundled @sparticuz/chromium is used automatically.
PDF_CHROME_PATH=
# Optional: hard limit for one PDF in milliseconds (default 270000 = 4.5 min)
PDF_TIMEOUT_MS=270000
